{
  "golden": "secret_standard_build.json",
  "mutations": [
    {
      "id": "secret-other-name",
      "must_deny": true,
      "patch": [
        {
          "op": "replace",
          "path": "/metadata/name",
          "value": "factory-w-ffffffffffffffffffffffffffffffff-s"
        }
      ],
      "rule": "secret-name"
    },
    {
      "id": "secret-name-without-suffix",
      "must_deny": true,
      "patch": [
        {
          "op": "replace",
          "path": "/metadata/name",
          "value": "factory-w-0123456789abcdef0123456789abcdef"
        }
      ],
      "rule": "secret-name"
    },
    {
      "id": "secret-other-namespace",
      "must_deny": true,
      "patch": [
        {
          "op": "replace",
          "path": "/metadata/namespace",
          "value": "factory"
        }
      ],
      "rule": "secret-namespace"
    },
    {
      "id": "secret-type-docker-config",
      "must_deny": true,
      "patch": [
        {
          "op": "replace",
          "path": "/type",
          "value": "kubernetes.io/dockerconfigjson"
        }
      ],
      "rule": "secret-type"
    },
    {
      "id": "secret-type-service-account-token",
      "must_deny": true,
      "patch": [
        {
          "op": "replace",
          "path": "/type",
          "value": "kubernetes.io/service-account-token"
        }
      ],
      "rule": "secret-type"
    },
    {
      "id": "secret-type-absent",
      "must_deny": true,
      "patch": [
        {
          "op": "remove",
          "path": "/type"
        }
      ],
      "rule": "secret-type"
    },
    {
      "id": "secret-extra-key",
      "must_deny": true,
      "patch": [
        {
          "op": "add",
          "path": "/data/extra",
          "value": "eA=="
        }
      ],
      "rule": "secret-keys"
    },
    {
      "id": "secret-missing-token",
      "must_deny": true,
      "patch": [
        {
          "op": "remove",
          "path": "/data/token"
        }
      ],
      "rule": "secret-keys"
    },
    {
      "id": "secret-missing-anthropic-key",
      "must_deny": true,
      "patch": [
        {
          "op": "remove",
          "path": "/data/anthropic-api-key"
        }
      ],
      "rule": "secret-keys"
    },
    {
      "id": "secret-empty-value",
      "must_deny": true,
      "patch": [
        {
          "op": "replace",
          "path": "/data/token",
          "value": ""
        }
      ],
      "rule": "secret-keys"
    },
    {
      "id": "secret-value-not-base64",
      "must_deny": true,
      "patch": [
        {
          "op": "replace",
          "path": "/data/token",
          "value": "not base64!"
        }
      ],
      "rule": "secret-keys"
    },
    {
      "id": "secret-string-data-added",
      "must_deny": true,
      "patch": [
        {
          "op": "add",
          "path": "/stringData",
          "value": {
            "extra": "x"
          }
        }
      ],
      "rule": "secret-fields"
    },
    {
      "id": "secret-owner-missing",
      "must_deny": true,
      "patch": [
        {
          "op": "remove",
          "path": "/metadata/ownerReferences"
        }
      ],
      "rule": "secret-owner"
    },
    {
      "id": "secret-owner-empty",
      "must_deny": true,
      "patch": [
        {
          "op": "replace",
          "path": "/metadata/ownerReferences",
          "value": []
        }
      ],
      "rule": "secret-owner"
    },
    {
      "id": "secret-owner-kind-deployment",
      "must_deny": true,
      "patch": [
        {
          "op": "replace",
          "path": "/metadata/ownerReferences/0/kind",
          "value": "Deployment"
        }
      ],
      "rule": "secret-owner"
    },
    {
      "id": "secret-owner-other-pod",
      "must_deny": true,
      "patch": [
        {
          "op": "replace",
          "path": "/metadata/ownerReferences/0/name",
          "value": "factory-w-ffffffffffffffffffffffffffffffff"
        }
      ],
      "rule": "secret-owner"
    },
    {
      "id": "secret-owner-block-owner-deletion",
      "must_deny": true,
      "patch": [
        {
          "op": "add",
          "path": "/metadata/ownerReferences/0/blockOwnerDeletion",
          "value": true
        }
      ],
      "rule": "secret-owner"
    },
    {
      "id": "secret-owner-controller",
      "must_deny": true,
      "patch": [
        {
          "op": "add",
          "path": "/metadata/ownerReferences/0/controller",
          "value": true
        }
      ],
      "rule": "secret-owner"
    },
    {
      "id": "secret-owner-no-uid",
      "must_deny": true,
      "patch": [
        {
          "op": "remove",
          "path": "/metadata/ownerReferences/0/uid"
        }
      ],
      "rule": "secret-owner"
    },
    {
      "id": "secret-owner-two",
      "must_deny": true,
      "patch": [
        {
          "op": "add",
          "path": "/metadata/ownerReferences/-",
          "value": {
            "apiVersion": "v1",
            "kind": "Pod",
            "name": "factory-w-ffffffffffffffffffffffffffffffff",
            "uid": "11111111-2222-4333-8444-666666666666"
          }
        }
      ],
      "rule": "secret-owner"
    },
    {
      "id": "secret-finalizer",
      "must_deny": true,
      "patch": [
        {
          "op": "add",
          "path": "/metadata/finalizers",
          "value": [
            "example.invalid/hold"
          ]
        }
      ],
      "rule": "secret-fields"
    },
    {
      "id": "secret-immutable",
      "must_deny": true,
      "patch": [
        {
          "op": "add",
          "path": "/immutable",
          "value": true
        }
      ],
      "rule": "secret-fields"
    },
    {
      "id": "secret-wrong-kind",
      "must_deny": true,
      "patch": [
        {
          "op": "replace",
          "path": "/kind",
          "value": "ConfigMap"
        }
      ],
      "rule": "secret-fields"
    },
    {
      "id": "secret-generate-name",
      "must_deny": true,
      "patch": [
        {
          "op": "add",
          "path": "/metadata/generateName",
          "value": "x-"
        }
      ],
      "rule": "secret-fields"
    }
  ],
  "pod_name": "factory-w-0123456789abcdef0123456789abcdef"
}
