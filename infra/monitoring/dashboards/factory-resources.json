      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 13,
      "type": "row",
      "title": "Manager API",
      "collapsed": false,
      "gridPos": {
