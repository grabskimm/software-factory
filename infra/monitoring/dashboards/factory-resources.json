    {
      "id": 14,
      "type": "timeseries",
      "title": "Requests per second by status class",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "factory-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 36
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "factory-prometheus"
          },
          "expr": "sum by (status_class) (rate(factory_manager_requests_total[5m]))",
          "legendFormat": "{{status_class}}",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
