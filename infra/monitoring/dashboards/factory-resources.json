{
  "uid": "factory-resources",
  "title": "Factory resources and manager",
  "tags": [
    "factory"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timezone": "browser",
  "annotations": {
    "list": []
  },
  "links": [],
  "templating": {
    "list": [
      {
        "name": "repo",
        "label": "Repository",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "factory-prometheus"
        },
        "query": {
          "query": "label_values(factory_jobs, repo)",
          "refId": "repo"
        },
        "definition": "label_values(factory_jobs, repo)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Pod against its limits (kubelet container metrics)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Memory working set against the limit",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "factory-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "factory-prometheus"
          },
          "expr": "max(container_memory_working_set_bytes{namespace=\"factory\",container=\"factory\"})",
          "legendFormat": "working set",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "factory-prometheus"
          },
          "expr": "max(container_spec_memory_limit_bytes{namespace=\"factory\",container=\"factory\"})",
          "legendFormat": "limit",
          "refId": "B",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "CPU usage against the limit (cores)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "factory-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "factory-prometheus"
          },
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"factory\",container=\"factory\"}[5m]))",
          "legendFormat": "usage",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "factory-prometheus"
          },
          "expr": "max(container_spec_cpu_quota{namespace=\"factory\",container=\"factory\"}) / max(container_spec_cpu_period{namespace=\"factory\",container=\"factory\"})",
          "legendFormat": "limit",
          "refId": "B",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Memory working set of the monitoring pods",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "factory-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "factory-prometheus"
          },
          "expr": "max by (pod) (container_memory_working_set_bytes{namespace=\"monitoring\",container!=\"\"})",
          "legendFormat": "{{pod}}",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Out-of-memory events and container starts",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "factory-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "factory-prometheus"
          },
          "expr": "sum(increase(container_oom_events_total{namespace=\"factory\",container=\"factory\"}[1h]))",
          "legendFormat": "OOM events",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "factory-prometheus"
          },
          "expr": "sum(changes(container_start_time_seconds{namespace=\"factory\",container=\"factory\"}[1h]))",
          "legendFormat": "container starts",
          "refId": "B",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "type": "row",
      "title": "Footprint per session (retained runs)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "panels": []
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Peak resident MiB per session by phase",
      "description": "Answers the capacity question: what one session costs.",
      "datasource": {
        "type": "prometheus",
        "uid": "factory-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "factory-prometheus"
          },
          "expr": "max by (phase) (factory_phase_peak_rss_mib{repo=~\"$repo\"})",
          "legendFormat": "{{phase}}",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decmbytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
