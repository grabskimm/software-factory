      "gridPos": {
        "h": 8,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "factory-prometheus"
          },
          "expr": "sum(factory_capacity_workers{part=\"in_use\"}) + (sum(factory_worker_pods{part=\"live\"}) or vector(0))",
