#!/usr/bin/python3
"""A TEST-ONLY stand-in for the `claude` CLI, for tools/local_pod_e2e (docs/pod-backend-local-e2e.md).

It calls no API and holds no key. It reads the prompt from standard input (as `claude -p` does), takes its behaviour from the first
line of the prompt, `STUB mode=<mode> [key=value ...]`, and writes a stream-json transcript on standard output: a system event, an
assistant event and, unless the mode says otherwise, a `result` event with a structured output that satisfies the phase's schema.

Modes:  ok  edit  noedit  sleep  exit  noresult  scope-link  scope-git  scope-dotdot  readonly-write  probe  net  big
`probe` and `net` write what they saw to PROBE_OUT (a file in the worktree, which the delta carries back) as booleans and counts ONLY:
no value of any variable or file is ever written, so no secret can reach a note.
"""

import json
import os
import socket
import sys
import time

argv = sys.argv[1:]
prompt = sys.stdin.read()
first = prompt.splitlines()[0] if prompt.strip() else ""
opts = dict(item.split("=", 1) for item in first.split()[1:] if "=" in item) if first.startswith("STUB") else {}
mode = opts.get("mode", "ok")
cwd = os.getcwd()
PROBE_OUT = os.path.join(cwd, opts.get("out", "probe-result.json"))


def emit(event):
    sys.stdout.write(json.dumps(event) + "\n")
    sys.stdout.flush()


def result(structured=None, subtype="success", is_error=False):
    emit(
        {
            "type": "result",
            "subtype": subtype,
            "is_error": is_error,
            "duration_ms": 1234,
            "num_turns": 2,
            "result": json.dumps(structured if structured is not None else {}),
            "structured_output": structured,
            "total_cost_usd": 0.0123,
            "usage": {"input_tokens": 100, "output_tokens": 20, "cache_read_input_tokens": 0, "cache_creation_input_tokens": 0},
            "modelUsage": {"stub-model": {"inputTokens": 100, "outputTokens": 20, "costUSD": 0.0123}},
        }
    )


BUILD = {"summary": "stub edit", "blocked": False, "tests": [], "feature": False}
REVIEW = {"pass": True, "findings": []}

emit({"type": "system", "subtype": "init", "session_id": "stub", "model": "stub-model", "cwd": cwd, "tools": []})
emit({"type": "assistant", "message": {"role": "assistant", "content": [{"type": "text", "text": "stub agent working"}]}})


def write(path, text):
    os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
    with open(path, "w") as handle:
        handle.write(text)


def tcp(host, port, timeout=2.0):
    try:
        connection = socket.create_connection((host, port), timeout=timeout)
    except OSError:
        return False
    connection.close()
    return True


if mode in ("ok", "edit"):
    write(os.path.join(cwd, opts.get("file", "hello.txt")), "hello from the pod\n")
    write(os.path.join(cwd, "sub", "nested.txt"), "nested\n")
    result(REVIEW if opts.get("phase") == "review" else BUILD)
elif mode == "sleep":
    write(os.path.join(cwd, "slept.txt"), "edit before the timeout\n")
    time.sleep(float(opts.get("seconds", "3600")))
    result(BUILD)
elif mode == "exit":
    if opts.get("result") == "1":
        write(os.path.join(cwd, "hello.txt"), "edited then failed\n")
        result(BUILD)
    sys.stderr.write("stub: exiting with a failure\n")
    sys.exit(int(opts.get("code", "3")))
elif mode == "noedit":
    result(REVIEW)
elif mode == "noresult":
    pass
elif mode == "scope-link":
    write(os.path.join(cwd, "hello.txt"), "x\n")
    os.symlink("/etc/passwd", os.path.join(cwd, "evil-link"))
    result(BUILD)
elif mode == "scope-git":
    write(os.path.join(cwd, ".git", "hooks", "pre-commit"), "#!/bin/sh\necho owned\n")
    write(os.path.join(cwd, "hello.txt"), "x\n")
    result(BUILD)
elif mode == "scope-dotdot":
    try:
        write(os.path.join(os.path.dirname(cwd), "outside-the-worktree.txt"), "outside\n")
        write(os.path.join(os.path.dirname(cwd), "..", "outside-too.txt"), "outside\n")
    except OSError:
        sys.stderr.write("stub: the write outside the worktree was refused by the file system\n")
    write(os.path.join(cwd, "hello.txt"), "x\n")
    result(BUILD)
elif mode == "readonly-write":
    write(os.path.join(cwd, "should-not-exist.txt"), "a read-only phase wrote this\n")
    result(REVIEW)
elif mode == "big":
    with open(os.path.join(cwd, "big.bin"), "wb") as handle:
        handle.write(os.urandom(int(opts.get("mb", "40")) * 1024 * 1024))
    result(BUILD)
elif mode == "probe":
    seen = {"uid": os.getuid(), "gid": os.getgid(), "groups": os.getgroups()}
    seen["env_names_with_secret_shape"] = sorted(
        k for k in os.environ if any(w in k.upper() for w in ("TOKEN", "KEY", "SECRET", "PASSWORD"))
    )
    seen["env_count"] = len(os.environ)
    seen["env_names"] = sorted(os.environ)
    seen["has_anthropic_key_env"] = "ANTHROPIC_API_KEY" in os.environ
    seen["has_relay_url_env"] = "FACTORY_RELAY_URL" in os.environ
    checks = {}
    for label, path in (
        ("token_file_readable", "/run/factory-session/token"),
        ("key_file_readable", "/run/factory-session/anthropic-api-key"),
        ("sa_token_exists", "/var/run/secrets/kubernetes.io/serviceaccount/token"),
        ("proc1_environ_readable", "/proc/1/environ"),
        ("etc_shadow_readable", "/etc/shadow"),
    ):
        try:
            with open(path, "rb") as handle:
                handle.read(1)
            checks[label] = True
        except OSError:
            checks[label] = False
    try:
        checks["session_dir_listable"] = bool(os.listdir("/run/factory-session"))
    except OSError:
        checks["session_dir_listable"] = False
    for label, path in (
        ("data_root_writable", "/data/x-probe"),
        ("run_dir_writable", "/run/x-probe"),
        ("usr_writable", "/usr/x-probe"),
        ("tmp_writable", "/tmp/x-probe"),
    ):
        try:
            with open(path, "w"):
                pass
            os.unlink(path)
            checks[label] = True
        except OSError:
            checks[label] = False
    scan = {"readable_foreign_environ_with_relay_url": 0, "foreign_process_environs_readable": 0}
    for entry in os.listdir("/proc"):
        if entry.isdigit() and int(entry) != os.getpid():
            try:
                with open(f"/proc/{entry}/environ", "rb") as handle:
                    blob = handle.read()
                scan["foreign_process_environs_readable"] += 1
                if b"FACTORY_RELAY_URL" in blob or b"ANTHROPIC_API_KEY" in blob:
                    scan["readable_foreign_environ_with_relay_url"] += 1
            except OSError:
                pass
    seen["checks"] = checks
    seen["proc_scan"] = scan
    write(PROBE_OUT, json.dumps(seen, indent=1, sort_keys=True) + "\n")
    result(BUILD)
elif mode == "net":
    # The agent's environment holds no FACTORY_* variable (that is what E11 shows), so every address comes from the prompt.
    mgr = opts.get("mgr", "")
    targets = {
        "relay_control": (opts.get("relay", ""), int(opts.get("relay_port", "8090"))),
        "relay_pod_ip_direct": (opts.get("manager_ip", ""), int(opts.get("relay_port", "8090"))),
        "manager_service_8080": (mgr, 8080),
        "manager_pod_ip_8080": (opts.get("manager_ip", ""), 8080),
        "manager_pod_ip_9464": (opts.get("manager_ip", ""), 9464),
        "node_kubelet_10250": (opts.get("node_ip", ""), 10250),
        "api_service_443": (opts.get("api_svc", ""), 443),
        "api_node_6443": (opts.get("api_ip", ""), 6443),
        "api_proxy_443": (opts.get("api_proxy", ""), 443),
        "imds_80": ("169.254.169.254", 80),
        "wireserver_80": ("168.63.129.16", 80),
        "hostga_32526": ("168.63.129.16", 32526),
        "external_443": (opts.get("ext", "1.1.1.1"), 443),
        "external_80": (opts.get("ext", "1.1.1.1"), 80),
        "dns_tcp_53_external": ("1.1.1.1", 53),
        "other_pod_8080": (opts.get("peer_ip", ""), 8080),
    }
    outcome = {}
    for label, (host, port) in targets.items():
        outcome[label] = tcp(host, port) if host else None
    try:
        outcome["dns_resolves_cluster"] = bool(socket.getaddrinfo("kubernetes.default.svc.cluster.local", 443))
    except OSError:
        outcome["dns_resolves_cluster"] = False
    write(PROBE_OUT, json.dumps(outcome, indent=1, sort_keys=True) + "\n")
    result(BUILD)
else:
    sys.stderr.write("stub: unknown mode\n")
    sys.exit(2)
sys.exit(0)
