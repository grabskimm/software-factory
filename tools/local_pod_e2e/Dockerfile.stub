# TEST ONLY: the factory image plus a stub `claude` stand-in and a start-up settle shim. Nothing else is changed
# (tools/local_pod_e2e/harness.py, docs/pod-backend-local-e2e.md, deviation V4 and defect D3).
ARG BASE
FROM ${BASE}
COPY --chmod=0755 stub-claude /usr/local/bin/stub-claude
# V4: the NetworkPolicy engine of the kind cluster (kindnet's) starts enforcing about one second AFTER a pod's container starts
# (measured: connects to a forbidden address succeed for the first ~1 s), which Cilium's endpoint setup does not allow. The worker
# command is pinned by the admission policy (tini, python, -m factory.podworker), so the settle sits INSIDE tini's path: the
# real binary is kept as tini.real and the shim sleeps before it execs it. The canary, the policy and the podspec are untouched.
RUN mv /usr/bin/tini /usr/bin/tini.real \
    && printf '%s\n' '#!/bin/sh' 'sleep "${E2E_ENGINE_SETTLE_SECONDS:-5}"' 'exec /usr/bin/tini.real "$@"' > /usr/bin/tini \
    && chmod 0755 /usr/bin/tini
